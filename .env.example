# Copy to .env and adjust. All variables below are optional.

# Camera source: integer index, video file path, rtsp:// URL, or "synthetic"
CAMERA_SOURCE=0

# YOLO model placement (relative to project root)
# DETECT_MODEL_PATH=models/weapon_model.pt
# DETECT_DETECTOR_MODE=auto        # auto | yolo | stub

# Temporal confirmation logic
# DETECT_CONFIDENCE_THRESHOLD=0.80
# CONFIRM_WINDOW=5
# CONFIRM_MIN_POSITIVE=3

# Event handling
# EVENTS_COOLDOWN_SECONDS=10.0
# EVENTS_EVIDENCE_DIR=events

# Violence detection (functional with a real model; stub otherwise)
# VIOLENCE_ENABLED=false

# API
# API_HOST=127.0.0.1
# API_PORT=8000
# API_REQUIRE_AUTH_TOKEN=false
# API_AUTH_TOKEN=change-me

# Logging
# LOG_LEVEL=INFO